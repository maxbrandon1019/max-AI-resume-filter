# LLM Configuration
# Choose your preferred provider: 'gemini' | 'openai' | 'mock'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional, if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store & Search Configuration
SIMILARITY_TOP_K=5
HYBRID_ALPHA=0.6  # 1.0 = Pure Vector Search, 0.0 = Pure BM25 Keyword Search
RERANK_ENABLED=true

# Recruiter Preferences
ENABLE_PII_MASKING=false
MIN_FIT_SCORE_THRESHOLD=60.0
